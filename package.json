{
  "name": "riva",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RIVA (Ride Intelligence & Virtual Assistance) — a multi-agent mobility copilot for riders and drivers: A* routing, Contract Net negotiation, MDP shift planning",
  "scripts": {
    "dev": "nitrostack-cli dev",
    "build": "nitrostack-cli build",
    "start": "npm run build && nitrostack-cli start",
    "start:prod": "nitrostack-cli start",
    "build:dev": "tsc -p tsconfig.dev.json",
    "test": "npm run build:dev && node --test --test-force-exit \".build/tests/*.test.js\"",
    "demo": "npm run build:dev && node .build/scripts/demo.js",
    "evaluate": "npm run build:dev && node .build/scripts/evaluate.js",
    "examples": "npm run build:dev && node .build/scripts/examples.js",
    "gallery": "node scripts/gallery.mjs",
    "site": "node scripts/build-site.mjs",
    "upgrade": "nitrostack-cli upgrade",
    "install:all": "nitrostack-cli install",
    "widget": "npm --prefix src/widgets"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "@nitrostack/core": "^1.0.14",
    "zod": "^3.22.4",
    "@modelcontextprotocol/ext-apps": ">=0.1.0"
  },
  "devDependencies": {
    "@nitrostack/cli": "^1.0.15",
    "@types/node": "^22.10.0",
    "typescript": "^5.3.3"
  },
  "author": "RIVA Team",
  "nitrostack": {
    "skillsVersion": "1.0.0"
  }
}
