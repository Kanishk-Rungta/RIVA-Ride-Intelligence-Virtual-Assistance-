# NitroStack Configuration
NITRO_LOG_LEVEL=info
NITROSTACK_APP_MODE=universal

# RIVA (Ride Intelligence & Virtual Assistance) — External Integrations (Optional)
# =============================================================================
# The server starts and works fully without these — Geoapify falls back
# to a deterministic location/route estimate, and Rapido falls back to
# simulated pricing. Set these for live geocoding, live routing, and live
# Rapido fares.
# =============================================================================
# GEOAPIFY_API_KEY=your-geoapify-api-key
# GEOAPIFY_COUNTRY_CODE=in
# APIFY_API_TOKEN=your-apify-api-token
# APIFY_RAPIDO_ACTOR_ID=your-actor-id-or-slug

# Server Transport Configuration (Optional)
# =============================================================================
# MCP_TRANSPORT_TYPE: Toggles transport mode. Values: stdio | http | dual.
# Defaults to 'stdio' in development and 'dual' in production/NODE_ENV=production.
# =============================================================================
# MCP_TRANSPORT_TYPE=stdio
# PORT=3000
# HOST=localhost
# ENABLE_CORS=true
